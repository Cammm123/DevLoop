[Unit]
Description=Import public GitHub pushes into DevLoop
After=network-online.target devloop-server.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/devloop/collector
ExecStart=%h/devloop/collector/.venv/bin/devloop github-sync --username REPLACE_WITH_GITHUB_USERNAME
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/devloop
